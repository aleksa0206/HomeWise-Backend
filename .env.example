PORT=4000

# Matches docker-compose.yaml
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=homewise_app
DB_PASSWORD=homewise_app
DB_NAME=homewise
DATABASE_URL="mysql://homewise_app:homewise_app@127.0.0.1:3306/homewise"

# At least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Required only when NODE_ENV=production
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Enables GET /metrics for Prometheus (min 16 chars); must match monitoring/prometheus.yml
METRICS_TOKEN=dev-metrics-token-local
