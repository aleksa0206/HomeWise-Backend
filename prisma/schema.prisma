generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  Owner
  Member
}

enum CategoryType {
  Income
  Expense
}

enum ChoreStatus {
  Open
  Done
}

enum Recurrence {
  None
  Daily
  Weekly
  Monthly
  Yearly
}

enum Priority {
  Low
  Normal
  High
}

enum NotificationType {
  ChoreAssigned
  ChoreCompleted
  ChoreCommented
  BillAssigned
  General
}

model Household {
  id        Int      @id @default(autoincrement())
  name      String
  currency  String   @default("RSD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  categories   Category[]
  budgets      Budget[]
  transactions Transaction[]
  chores        Chore[]
  comments      Comment[]
  auditLogs     AuditLog[]
  bills         Bill[]
  shoppingLists ShoppingList[]
  shoppingItems ShoppingItem[]
}

model User {
  id                     Int       @id @default(autoincrement())
  householdId            Int
  failedLoginAttempts    Int       @default(0)
  firstName              String
  lastName               String
  email                  String    @unique
  passwordHash           String
  twoFactorSecret        String?
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  lockedUntil            DateTime?
  twoFactorEnabled       Boolean   @default(false)
  role                   Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household      @relation(fields: [householdId], references: [id])
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  comments        Comment[]
  transactions    Transaction[]
  createdChores   Chore[]        @relation("CreatedChores")
  assignedChores  Chore[]        @relation("AssignedChores")
  completedChores Chore[]        @relation("CompletedChores")
  bills           Bill[]
  shoppingLists   ShoppingList[]
  addedItems      ShoppingItem[] @relation("AddedItems")
  checkedItems    ShoppingItem[] @relation("CheckedItems")

  @@index([householdId])
}

model Category {
  id          Int          @id @default(autoincrement())
  householdId Int
  name        String
  type        CategoryType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household    Household     @relation(fields: [householdId], references: [id])
  budgets      Budget[]
  transactions Transaction[]
  bills        Bill[]

  @@unique([householdId, name])
}

// Planned amount for one category in one month.
model Budget {
  id          Int     @id @default(autoincrement())
  householdId Int
  categoryId  Int
  year        Int
  month       Int
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id])
  category  Category  @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, year, month])
  @@index([householdId, year, month])
}

// Income or expense, depending on its category's type. `userId` is who paid / received it.
model Transaction {
  id          Int      @id @default(autoincrement())
  householdId Int
  categoryId  Int
  userId      Int
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id])
  category  Category  @relation(fields: [categoryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([householdId, date])
}

model Chore {
  id            Int         @id @default(autoincrement())
  householdId   Int
  createdById   Int
  assigneeId    Int?
  completedById Int?
  title         String
  description   String?     @db.Text
  status        ChoreStatus @default(Open)
  priority      Priority    @default(Normal)
  recurrence    Recurrence  @default(None)
  dueDate       DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household   Household @relation(fields: [householdId], references: [id])
  createdBy   User      @relation("CreatedChores", fields: [createdById], references: [id])
  assignee    User?     @relation("AssignedChores", fields: [assigneeId], references: [id])
  completedBy User?     @relation("CompletedChores", fields: [completedById], references: [id])
  comments    Comment[]

  @@index([householdId, dueDate])
}

// A recurring (or one-off) payment. Paying it records an expense transaction and moves
// `nextDueDate` forward; a one-off bill becomes inactive once paid.
model Bill {
  id            Int        @id @default(autoincrement())
  householdId   Int
  categoryId    Int
  responsibleId Int?
  name          String
  amount        Decimal    @db.Decimal(12, 2)
  recurrence    Recurrence @default(Monthly)
  nextDueDate   DateTime
  isActive      Boolean    @default(true)
  lastPaidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household   Household @relation(fields: [householdId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])
  responsible User?     @relation(fields: [responsibleId], references: [id])

  @@index([householdId, nextDueDate])
}

model ShoppingList {
  id          Int      @id @default(autoincrement())
  householdId Int
  createdById Int
  name        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household      @relation(fields: [householdId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     ShoppingItem[]

  @@index([householdId])
}

model ShoppingItem {
  id          Int     @id @default(autoincrement())
  listId      Int
  householdId Int
  addedById   Int
  checkedById Int?
  name        String
  quantity    String?
  isChecked   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list      ShoppingList @relation(fields: [listId], references: [id])
  household Household    @relation(fields: [householdId], references: [id])
  addedBy   User         @relation("AddedItems", fields: [addedById], references: [id])
  checkedBy User?        @relation("CheckedItems", fields: [checkedById], references: [id])

  @@index([listId])
}

model Comment {
  id          Int      @id @default(autoincrement())
  choreId     Int
  authorId    Int
  householdId Int
  text        String   @db.Text
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  chore     Chore     @relation(fields: [choreId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  type      NotificationType

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  performedById Int
  entityId      Int
  householdId   Int
  action        String
  entityType    String
  oldValue      String?
  newValue      String?
  createdAt     DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id])
  performedBy User      @relation(fields: [performedById], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model RateLimitEntry {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
